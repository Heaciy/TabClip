{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "strict": true,
        "skipLibCheck": true,
        "paths": {
            "@": ["./src"],
            "@/*": ["./src/*"]
        }
    },
    "include": ["./**/*", "./.wxt/wxt.d.ts", "docs/.vitepress/config.ts"],
    "exclude": ["./output"]
}
